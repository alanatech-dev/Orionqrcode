{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "orionqrcodevercelapp.vercel.app" }],
      "destination": "https://orionsolucoes.vercel.app/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
